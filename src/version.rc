// Windows version resource: shows in the file's Properties > Details and in ReShade's add-on list.
#include <winver.h>
#include "version.h"

VS_VERSION_INFO VERSIONINFO
FILEVERSION ADDON_VERSION_MAJOR, ADDON_VERSION_MINOR, ADDON_VERSION_PATCH, 0
PRODUCTVERSION ADDON_VERSION_MAJOR, ADDON_VERSION_MINOR, ADDON_VERSION_PATCH, 0
FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
FILEFLAGS 0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_DLL
FILESUBTYPE VFT2_UNKNOWN
BEGIN
	BLOCK "StringFileInfo"
	BEGIN
		BLOCK "040904B0"
		BEGIN
			VALUE "FileDescription", "DLSS frame generation for Factorio (ReShade add-on)"
			VALUE "FileVersion", ADDON_VERSION_STRING
#ifdef FG_RELEASE
			VALUE "InternalName", "factorio_fg"
			VALUE "OriginalFilename", "factorio_fg.addon64"
#else
			VALUE "InternalName", "hudless_probe"
			VALUE "OriginalFilename", "hudless_probe.addon64"
#endif
			VALUE "ProductName", "Factorio frame generation"
			VALUE "ProductVersion", ADDON_VERSION_FULL
		END
	END
	BLOCK "VarFileInfo"
	BEGIN
		VALUE "Translation", 0x409, 1200
	END
END
